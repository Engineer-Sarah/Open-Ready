# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Optional: raises the GitHub API rate limit from 60 to 5000 requests per hour.
# Create a token at GitHub > Settings > Developer settings. No scopes needed for public repos.
GITHUB_TOKEN=

# Optional: enables the "Explain in simple words" AI feature (free key from Google AI Studio).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-latest).
GEMINI_MODEL=
